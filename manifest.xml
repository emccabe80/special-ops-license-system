<?xml version="1.0" encoding="UTF-8"?>
<!--
  Special OPS — Add-in Manifest
  ========================================
  Placeholders you MUST replace before this works — see SETUP_GUIDE.md:
    Hosted at: https://emccabe80.github.io/special-ops-license-system/
    Azure app registration ("Special OPS Access Control"):
      Client ID: feab1bc7-3546-4d1a-a4db-f6431d0e1980
      Tenant ID: 20588be3-3863-4403-b036-127ca0b3f9b4 (MJM Construction Management, single-tenant)
      Both filled in below, and GitHub Pages URL now set too.

  This targets Excel specifically (Workbook host) and requests SSO so the
  add-in can identify the signed-in user without a manual sign-in prompt.
-->
<OfficeApp
    xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
    xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
    xsi:type="TaskPaneApp">

  <Id>16ee5dbd-704f-428f-bd74-266789d6eb85</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Uncomfortable Action Limited</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Special OPS — Access Control" />
  <Description DefaultValue="Verifies authorization before this workbook can be used." />
  <IconUrl DefaultValue="https://emccabe80.github.io/special-ops-license-system/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://emccabe80.github.io/special-ops-license-system/icon-80.png" />
  <SupportUrl DefaultValue="https://emccabe80.github.io/special-ops-license-system/support.html" />

  <AppDomains>
    <AppDomain>https://emccabe80.github.io</AppDomain>
    <AppDomain>https://login.microsoftonline.com</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Workbook" />
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://emccabe80.github.io/special-ops-license-system/taskpane.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <!-- SSO configuration: lets the add-in silently obtain the signed-in
       user's identity via Office.js, rather than prompting a manual login. -->
  <WebApplicationInfo>
    <Id>feab1bc7-3546-4d1a-a4db-f6431d0e1980</Id>
    <Resource>api://emccabe80.github.io/feab1bc7-3546-4d1a-a4db-f6431d0e1980</Resource>
    <Scopes>
      <Scope>openid</Scope>
      <Scope>profile</Scope>
      <Scope>email</Scope>
    </Scopes>
  </WebApplicationInfo>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url" />
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="SpecialOps.Group1">
                <Label resid="Group1.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>
                <Control xsi:type="Button" id="SpecialOps.TaskpaneButton">
                  <Label resid="TaskpaneButton.Label" />
                  <Supertip>
                    <Title resid="TaskpaneButton.Label" />
                    <Description resid="TaskpaneButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://emccabe80.github.io/special-ops-license-system/icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://emccabe80.github.io/special-ops-license-system/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://emccabe80.github.io/special-ops-license-system/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://emccabe80.github.io/special-ops-license-system/taskpane.html" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://emccabe80.github.io/special-ops-license-system/taskpane.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Group1.Label" DefaultValue="Access Control" />
        <bt:String id="TaskpaneButton.Label" DefaultValue="Check Access" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Verify authorization for this workbook" />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
